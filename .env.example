# Database Configuration (PostgreSQL on VPS or Cloud)
DATABASE_URL="postgresql://oneclickbiz_user:YOUR_DB_PASSWORD@localhost:5432/oneclickbiz?schema=public"

# App & Domain URL
NEXT_PUBLIC_APP_URL="https://oneclickbiz.in"

# JWT Authentication Secret
JWT_SECRET="YOUR_SUPER_SECRET_JWT_PRODUCTION_KEY_2026"

# Super Admin Credential Override
ADMIN_EMAIL="admin@oneclickbiz.in"

# Cashfree Payment Gateway (Production / Sandbox)
CASHFREE_APP_ID="YOUR_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY"
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_ENV="PRODUCTION" # or TEST

# Google OAuth (Workspace / SSO)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
